{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.alephain.org/crucible/runner-opening-release-command-v1.schema.json",
  "x-contract-id": "alephain.crucible.runner_opening_release_command.v1",
  "x-contract-revision": 1,
  "title": "Independent Runner Opening Release Command V1",
  "$ref": "#/$defs/signed_envelope",
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "release_id",
        "tenant_id",
        "trading_mode",
        "runner_id",
        "deployment_instance_id",
        "deployment_spec_id",
        "deployment_spec_digest",
        "generation",
        "credential_scope_id",
        "credential_scope_digest",
        "account_identity",
        "basis_amount",
        "currency",
        "basis_version_digest",
        "opening_valuation_event_id",
        "issued_at"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "release_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "format": "crucible-opening-uuid"
        },
        "tenant_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "trading_mode": {
          "enum": [
            "sandbox",
            "testnet",
            "live"
          ]
        },
        "runner_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "format": "crucible-opening-uuid"
        },
        "deployment_instance_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "format": "crucible-opening-uuid"
        },
        "deployment_spec_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "format": "crucible-opening-uuid"
        },
        "deployment_spec_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "credential_scope_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "format": "crucible-opening-uuid"
        },
        "credential_scope_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "account_identity": {
          "oneOf": [
            {
              "$ref": "#/$defs/NativeIdentity"
            },
            {
              "$ref": "#/$defs/ReportedIdentity"
            }
          ]
        },
        "basis_amount": {
          "type": "string",
          "format": "crucible-opening-decimal96-unsigned",
          "pattern": "^(?:0|(?:[1-9][0-9]*(?:\\.[0-9]*[1-9])?|0\\.[0-9]*[1-9]))$"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3,12}$"
        },
        "basis_version_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "opening_valuation_event_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "format": "crucible-opening-uuid"
        },
        "issued_at": {
          "type": "string",
          "format": "crucible-opening-utc-autosi",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3,9})?Z$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "trading_mode": {
                "const": "sandbox"
              }
            }
          },
          "then": {
            "properties": {
              "account_identity": {
                "$ref": "#/$defs/NativeIdentity"
              }
            }
          },
          "else": {
            "properties": {
              "account_identity": {
                "$ref": "#/$defs/ReportedIdentity"
              }
            }
          }
        }
      ]
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "event_id",
        "tenant_id",
        "event_plane",
        "bounded_context",
        "aggregate_type",
        "aggregate_id",
        "aggregate_version",
        "event_type",
        "payload",
        "correlation_id",
        "actor_assertion_jti",
        "occurred_at"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "event_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "format": "crucible-opening-uuid"
        },
        "tenant_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "event_plane": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "trading_mode"
          ],
          "properties": {
            "kind": {
              "const": "mode"
            },
            "trading_mode": {
              "enum": [
                "sandbox",
                "testnet",
                "live"
              ]
            }
          }
        },
        "bounded_context": {
          "const": "deployment"
        },
        "aggregate_type": {
          "const": "runner_opening_release"
        },
        "aggregate_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "format": "crucible-opening-uuid"
        },
        "aggregate_version": {
          "type": "integer",
          "const": 1
        },
        "event_type": {
          "const": "RunnerOpeningReleaseCommand.v1"
        },
        "payload": {
          "$ref": "#/$defs/command"
        },
        "correlation_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "format": "crucible-opening-uuid"
        },
        "actor_assertion_jti": {
          "type": "null"
        },
        "occurred_at": {
          "type": "string",
          "format": "crucible-opening-utc-autosi",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3,9})?Z$"
        }
      }
    },
    "signed_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "signature_profile",
        "event_encoding",
        "event_bytes",
        "signature_key_id",
        "signature"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "signature_profile": {
          "const": "crucible-domain-event-v1-exact-bytes"
        },
        "event_encoding": {
          "const": "application/json;base64url"
        },
        "event_bytes": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "signature_key_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "signature": {
          "type": "string",
          "minLength": 86,
          "maxLength": 86,
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      }
    },
    "NativeIdentity": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "sandbox_account",
          "title": "Kind",
          "type": "string"
        },
        "incarnation": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "format": "crucible-opening-uuid"
        },
        "client_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Client Id",
          "type": "string"
        },
        "account_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Account Id",
          "type": "string"
        },
        "venue": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Venue",
          "type": "string"
        },
        "account_type": {
          "enum": [
            "CASH",
            "MARGIN",
            "BETTING",
            "WALLET"
          ],
          "title": "Account Type",
          "type": "string"
        },
        "configuration_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Configuration Sha256",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "incarnation",
        "client_id",
        "account_id",
        "venue",
        "account_type",
        "configuration_sha256"
      ],
      "title": "NativeIdentity",
      "type": "object"
    },
    "ReportedIdentity": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "sodex_account",
          "title": "Kind",
          "type": "string"
        },
        "main_wallet": {
          "pattern": "^0x[0-9a-fA-F]{40}$",
          "title": "Main Wallet",
          "type": "string"
        },
        "account_id": {
          "maximum": 18446744073709551615,
          "minimum": 1,
          "title": "Account Id",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "main_wallet",
        "account_id"
      ],
      "title": "ReportedIdentity",
      "type": "object"
    }
  },
  "x-required-format-assertions": [
    "crucible-opening-uuid",
    "crucible-opening-decimal96-unsigned",
    "crucible-opening-utc-autosi"
  ],
  "x-cross-field-invariants": [
    "subject, tenant, mode and runner agree",
    "aggregate_id equals release_id",
    "event occurred_at equals issued_at",
    "actor_assertion_jti is present and null",
    "release does not change lifecycle generation"
  ],
  "x-runtime-boundary": "Contract only; issuer, transport routing, successful acknowledgement and opening remain unimplemented."
}
