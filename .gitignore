# custos .gitignore
#
# 独立开源仓库自足 gitignore, 不假设 monorepo 根 gitignore 存在.
# Non-custodial 承重墙延伸: user 本地开发环境物件不进 git 历史.

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
.eggs/

# 虚拟环境
.venv/
venv/
env/
ENV/

# 打包 / 发布
dist/
build/
wheels/
*.whl

# 测试 / 类型缓存
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyright_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# ---- custos 特化 ----
# credential_vault 本地 KEK / age key / sops 加密 blob (non-custodial 红线:
# 用户机器上的 ~/.custos/ 内容永不进 git).
# 注意: ~/ 展开在 gitignore 中不生效, 这里仅对仓库内路径生效; 用户 $HOME 下
# 的 ~/.custos/vault/ 不在本仓库范围, 无需 ignore.
.custos/
custos-vault/
*.age
*.age.key
*-key.txt

# 维护者的内部工作文档不属于公开仓库；本地以符号链接形式存在。
# scripts/check-public-surface.py 在 pre-commit 与 CI 中拒绝它们被跟踪。
/.forge
/.claude
/CLAUDE.md
/AGENTS.md

# examples/ 环境变量: 每个 example 目录的 .env 用于本地开发, 但 .env.example
# 是模板必须入 git — lesson #26 boundary constant 显式反向豁免
examples/*/.env
examples/**/.env
!examples/*/.env.example
!examples/**/.env.example

# examples/ 用户真实 vault: age 私钥 + sops 加密凭证 blob 永不入 git.
# vault-fixture/ 是模板目录 (无真 key, 名字不同不被命中), 必须入 git.
examples/**/vault/
# sops encrypt 前的明文凭证中间产物
*.plain.json

# 顶层 .env (若存在也是 secret, 但 .env.example 保留)
.env
.env.local
.env.*.local
!.env.example

# ---- IDE / 编辑器 ----
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# ---- 日志 / 临时 ----
*.log
tmp/
temp/

# Docs site (Plan 20)
docs-site/node_modules/
docs-site/build/
docs-site/.docusaurus/
docs-site/.cache-loader/
docs-site/.env.local
docs-site/.env.development.local
docs-site/.env.test.local
docs-site/.env.production.local
